DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BOOTSTRAP_SECRET=replace-with-a-random-private-setup-key

# Transactional password-reset email (Resend)
RESEND_API_KEY=re_replace_with_resend_api_key
PASSWORD_RESET_FROM_EMAIL="ALOYRI <security@your-verified-domain.com>"
# Optional. If omitted, reset links use the hostname where the request was made.
PASSWORD_RESET_BASE_URL=https://aloyriinventory-vercel-crm.vercel.app
