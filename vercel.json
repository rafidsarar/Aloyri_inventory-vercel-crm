{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "fix/*": false
    }
  },
  "buildCommand": "pnpm db:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/internal/notifications/process",
      "schedule": "*/5 * * * *"
    }
  ]
}
