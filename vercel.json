{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "ecommerce-e2e-bridge-*": true,
      "fix/*": false
    }
  },
  "buildCommand": "pnpm db:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/internal/notifications/process",
      "schedule": "0 3 * * *"
    }
  ]
}
