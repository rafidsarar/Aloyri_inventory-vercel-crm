{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "fix/*": false
    }
  },
  "buildCommand": "bash scripts/e2e-certification.sh seed-probe",
  "crons": [
    {
      "path": "/api/internal/notifications/process",
      "schedule": "0 3 * * *"
    }
  ]
}
