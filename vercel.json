{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "fix/*": false
    }
  },
  "buildCommand": "pnpm db:migrate && node --experimental-strip-types scripts/e2e-seed.ts && pnpm build",
  "crons": [
    {
      "path": "/api/internal/notifications/process",
      "schedule": "0 3 * * *"
    }
  ]
}
